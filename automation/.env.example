# Credenciales de la cuenta de prueba usada para automatización.
# Copiar como .env y completar con datos reales de una cuenta creada exclusivamente
# para este proyecto (nunca usar datos personales sensibles).
TEST_USER_EMAIL=usuario.prueba@example.com
TEST_USER_PASSWORD=CambiaEstaClave123

# Credenciales inválidas usadas para escenarios negativos (no deben existir realmente).
INVALID_USER_EMAIL=usuario.invalido@example.com
INVALID_USER_PASSWORD=ClaveInvalida999

BASE_URL=https://despensalo.cl/
